{
  "name": "@recodive/hansho",
  "version": "0.2.0",
  "description": "Official Node.js / TypeScript client for a Hansho hub: pair users, send notifications, pages, Live Activities and widget feeds, verify webhooks.",
  "license": "MIT",
  "homepage": "https://github.com/Recodive/hansho/tree/main/sdk/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recodive/hansho.git",
    "directory": "sdk/node"
  },
  "keywords": [
    "hansho",
    "push notifications",
    "apns",
    "live activities",
    "paging",
    "alerting"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:package": "node scripts/check-package.mjs",
    "check:examples": "tsc -p ../examples/node/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3"
  }
}
