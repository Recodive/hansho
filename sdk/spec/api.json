{
  "comment": "Wire contract of the hub sender API (hub/internal/api, hub/README.md). Both SDK test suites load this file: each operation lists the exact request the SDK must produce and a response the hub produces. Paths are the escaped request paths.",
  "auth_header": "Authorization",
  "auth_scheme": "Bearer",
  "operations": [
    {
      "name": "createPairingTicket",
      "method": "POST",
      "path": "/api/v1/pairing-tickets",
      "request": {"content_type": "application/json", "body": {"external_user_id": "user-42"}},
      "response": {"status": 201, "body": {"ticket": "tk_abc", "qr": "hansho://pair?hub=https%3A%2F%2Fhub.example.com&t=tk_abc&fp=ff00", "expires_at": "2026-11-08T12:10:00Z", "future_field": {"ignored": true}}}
    },
    {
      "name": "unpair",
      "method": "DELETE",
      "path": "/api/v1/users/user-42/pairings",
      "request": null,
      "response": {"status": 200, "body": {"revoked": 1}}
    },
    {
      "name": "putChannel",
      "method": "PUT",
      "path": "/api/v1/channels/ops",
      "request": {"content_type": "application/json", "body": {
        "name": "Operations", "default_level": "active", "max_level": "critical",
        "sound": "ding", "template_id": "status", "thread": "ops-thread",
        "actions": [{"id": "ack", "title": "Acknowledge", "ack": true}, {"id": "reply", "title": "Reply", "kind": "text"}]
      }},
      "response": {"status": 200, "body": {
        "id": "ops", "name": "Operations", "default_level": "active", "max_level": "critical",
        "sound": "ding", "template_id": "status", "thread": "ops-thread",
        "actions": [{"id": "ack", "title": "Acknowledge", "ack": true}, {"id": "reply", "title": "Reply", "kind": "text"}]
      }}
    },
    {
      "name": "getChannel",
      "method": "GET",
      "path": "/api/v1/channels/ops",
      "request": null,
      "response": {"status": 200, "body": {
        "id": "ops", "name": "Operations", "default_level": "active", "max_level": "critical",
        "sound": "", "template_id": "", "thread": "ops",
        "actions": [], "added_later": 1
      }}
    },
    {
      "name": "deleteChannel",
      "method": "DELETE",
      "path": "/api/v1/channels/ops",
      "request": null,
      "response": {"status": 204, "body": null}
    },
    {
      "name": "putTemplate",
      "method": "PUT",
      "path": "/api/v1/templates/status",
      "request": {"content_type": "application/json", "body": {
        "version": 2,
        "body": {"type": "vstack", "children": [{"type": "text", "style": "headline", "text": "{{title}}"}]}
      }},
      "response": {"status": 200, "body": {"id": "status", "version": 2}}
    },
    {
      "name": "putSound",
      "method": "PUT",
      "path": "/api/v1/sounds/ding",
      "request": {"content_type": "audio/wav", "raw_base64": "UklGRgAAAABXQVZF"},
      "response": {"status": 200, "body": {"id": "ding", "filename": "ding.wav", "sha256": "00", "size": 12}}
    },
    {
      "name": "sendMessage",
      "method": "POST",
      "path": "/api/v1/messages",
      "request": {"content_type": "application/json", "body": {
        "external_user_id": "user-42", "channel": "ops", "level": "time-sensitive",
        "title": "Disk full", "subtitle": "db-1", "body": "db-1 is at 97%",
        "image_url": "https://example.com/i.png", "template_id": "status",
        "data": {"disk": 97, "nested": {"snake_case_key": [1, 2]}},
        "sound": "ding", "actions": [{"id": "ack", "title": "Ack", "ack": true}], "collapse_id": "disk-db-1"
      }},
      "response": {"status": 202, "body": {
        "message_id": "msg_1", "level": "time-sensitive", "devices": 2, "status": "queued",
        "deliveries": [{"device_id": "dev_1", "status": "queued"}, {"device_id": "dev_2", "status": "queued"}],
        "future_field": "x"
      }}
    },
    {
      "name": "sendPage",
      "method": "POST",
      "path": "/api/v1/messages",
      "request": {"content_type": "application/json", "body": {
        "external_user_id": "user-42", "channel": "ops", "level": "page",
        "title": "Primary DB down", "body": "Failover did not complete",
        "page": {"interval_s": 60, "max_retries": 3}
      }},
      "response": {"status": 202, "body": {"message_id": "msg_2", "level": "page", "devices": 1, "status": "queued", "deliveries": [{"device_id": "dev_1", "status": "queued"}]}}
    },
    {
      "name": "getMessage",
      "method": "GET",
      "path": "/api/v1/messages/msg_2",
      "request": null,
      "response": {"status": 200, "body": {
        "message_id": "msg_2", "status": "acked", "level": "page", "attempts": 2,
        "deliveries": [{"device_id": "dev_1", "status": "sent", "error": ""}, {"device_id": "dev_2", "status": "failed", "error": "unregistered"}],
        "acked_at": "2026-11-08T12:05:00Z"
      }}
    },
    {
      "name": "startActivity",
      "method": "POST",
      "path": "/api/v1/activities",
      "request": {"content_type": "application/json", "body": {
        "external_user_id": "user-42", "channel": "ops", "template_id": "deploy",
        "data": {"progress": 0.1}, "alert": {"title": "Deploy started", "body": "v1.2.3"}
      }},
      "response": {"status": 201, "body": {"activity_id": "act_1", "devices": 1}}
    },
    {
      "name": "updateActivity",
      "method": "PATCH",
      "path": "/api/v1/activities/act_1",
      "request": {"content_type": "application/json", "body": {
        "data": {"progress": 0.6}, "priority": 10, "alert": {"title": "Halfway", "body": "60%"}
      }},
      "response": {"status": 202, "body": {"activity_id": "act_1", "update": 3}}
    },
    {
      "name": "endActivity",
      "method": "DELETE",
      "path": "/api/v1/activities/act_1",
      "request": null,
      "response": {"status": 202, "body": {"activity_id": "act_1"}}
    },
    {
      "name": "putFeed",
      "method": "PUT",
      "path": "/api/v1/feeds/uptime",
      "request": {"content_type": "application/json", "body": {
        "external_user_id": "user-42", "template_id": "status", "title": "Uptime", "data": {"up": true, "ms": 41}
      }},
      "response": {"status": 202, "body": {"feed_id": "uptime", "devices": 2}}
    },
    {
      "name": "putGroup",
      "method": "PUT",
      "path": "/api/v1/groups/oncall",
      "request": {"content_type": "application/json", "body": {"members": ["alice", "bob"]}},
      "response": {"status": 200, "body": {"id": "oncall", "members": ["alice", "bob"], "future_field": 1}}
    },
    {
      "name": "getGroup",
      "method": "GET",
      "path": "/api/v1/groups/oncall",
      "request": null,
      "response": {"status": 200, "body": {"id": "oncall", "members": ["alice", "bob"]}}
    },
    {
      "name": "deleteGroup",
      "method": "DELETE",
      "path": "/api/v1/groups/oncall",
      "request": null,
      "response": {"status": 204, "body": null}
    },
    {
      "name": "kick",
      "method": "DELETE",
      "path": "/api/v1/users/user-42/pairings",
      "request": null,
      "response": {"status": 200, "body": {"revoked": 1}}
    },
    {
      "name": "putChannelWithAudience",
      "method": "PUT",
      "path": "/api/v1/channels/ops",
      "request": {"content_type": "application/json", "body": {
        "name": "Operations", "default_level": "active", "max_level": "critical", "audience": {"mode": "only", "users": ["alice"], "groups": ["oncall"]}
      }},
      "response": {"status": 200, "body": {
        "id": "ops", "name": "Operations", "default_level": "active", "max_level": "critical",
        "sound": "", "template_id": "", "thread": "ops", "actions": [], "audience": {"mode": "only", "users": ["alice"], "groups": ["oncall"]}
      }}
    },
    {
      "name": "putFeedWithChannel",
      "method": "PUT",
      "path": "/api/v1/feeds/uptime",
      "request": {"content_type": "application/json", "body": {
        "template_id": "status", "channel": "ops", "audience": {"mode": "only", "users": ["alice"], "groups": ["oncall"]}, "data": {"up": true}
      }},
      "response": {"status": 202, "body": {"feed_id": "uptime", "devices": 1}}
    },
    {
      "name": "sendToAudience",
      "method": "POST",
      "path": "/api/v1/messages",
      "request": {"content_type": "application/json", "body": {
        "to_audience": true, "channel": "ops", "title": "Deploy done", "body": "v1.2.3 is live"
      }},
      "response": {"status": 202, "body": {"level": "active", "recipients": [
        {"external_user_id": "alice", "message_id": "msg_7", "status": "queued", "devices": 1, "deliveries": [{"device_id": "dev_1", "status": "queued"}]},
        {"external_user_id": "carol", "status": "no_access"}
      ]}}
    }
  ],
  "errors": [
    {"status": 400, "headers": {}, "body": {"error": "invalid_request", "field": "title", "message": "required"}, "code": "invalid_request", "field": "title", "retry_after_ms": 0},
    {"status": 401, "headers": {}, "body": {"error": "unauthorized"}, "code": "unauthorized", "field": "", "retry_after_ms": 0},
    {"status": 404, "headers": {}, "body": {"error": "unknown_channel"}, "code": "unknown_channel", "field": "", "retry_after_ms": 0},
    {"status": 404, "headers": {}, "body": {"error": "unknown_group"}, "code": "unknown_group", "field": "", "retry_after_ms": 0},
    {"status": 403, "headers": {}, "body": {"error": "no_access"}, "code": "no_access", "field": "", "retry_after_ms": 0},
    {"status": 429, "headers": {"Retry-After": "7"}, "body": {"error": "rate_limited"}, "code": "rate_limited", "field": "", "retry_after_ms": 7000},
    {"status": 502, "headers": {}, "body": null, "raw": "<html>bad gateway</html>", "code": "", "field": "", "retry_after_ms": 0}
  ]
}
