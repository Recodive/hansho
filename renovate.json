{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": { "labels": ["dependencies", "security"], "minimumReleaseAge": null },
  "packageRules": [
    {
      "description": "The SDKs are libraries: widen their dependency ranges instead of pinning",
      "matchFileNames": ["sdk/**"],
      "matchDepTypes": ["dependencies", "project.dependencies", "runtime", "require", "compile"],
      "rangeStrategy": "widen"
    },
    { "matchFileNames": ["sdk/python/**", "sdk/examples/python/**"], "groupName": "Python SDK" },
    { "matchFileNames": ["sdk/ruby/**", "sdk/examples/ruby/**"], "groupName": "Ruby SDK" },
    { "matchFileNames": ["sdk/php/**", "sdk/examples/php/**"], "groupName": "PHP SDK" },
    { "matchFileNames": ["sdk/java/**", "sdk/examples/java/**"], "groupName": "Java SDK" },
    { "matchFileNames": ["sdk/dotnet/**", "sdk/examples/dotnet/**"], "groupName": ".NET SDK" },
    { "matchFileNames": ["sdk/rust/**", "sdk/examples/rust/**"], "groupName": "Rust SDK" },
    { "matchFileNames": ["sdk/node/**", "sdk/examples/node/**"], "groupName": "Node SDK" },
    { "matchFileNames": ["hub/**"], "groupName": "hub" },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions",
      "schedule": ["before 6am on monday"]
    }
  ]
}
